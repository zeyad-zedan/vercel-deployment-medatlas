{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "jwks-rsa": "3.1.0",
    "@grpc/grpc-js": "1.13.6"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "start": "node server.ts",
    "start:prod": "NODE_ENV=production node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "pdf-tool": "tsx tools/local-pdf-tool.ts",
    "backup:create": "tsx scripts/backup-cli.ts create",
    "backup:verify": "tsx scripts/backup-cli.ts verify",
    "backup:restore-test": "tsx scripts/backup-cli.ts restore-test",
    "test": "npx --yes tsx --test src/lib/mcq-engine.test.ts src/lib/new-features.test.ts src/lib/auth-google-flow.test.ts src/lib/security-audit.test.ts src/lib/telegram-storage.test.ts src/lib/egress-monitor.test.ts",
    "test:features": "npx --yes tsx --test src/lib/mcq-engine.test.ts src/lib/new-features.test.ts src/lib/auth-google-flow.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
