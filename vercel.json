{
  "version": 2,
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://pivotal-bedrock-c01dl.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/(.*)",
      "destination": "https://pivotal-bedrock-c01dl.firebaseapp.com/__/firebase/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/lectures/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
