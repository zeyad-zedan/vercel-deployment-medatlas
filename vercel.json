{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{pdfjs-dist/**,@napi-rs/canvas*/**}"
    }
  },
  "headers": [
    {
      "source": "/impulse/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/lectures/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }]
    },
    {
      "source": "/api/documents/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/impulse/upload",
      "destination": "/impulse/index.html"
    },
    {
      "source": "/impulse/quiz/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/__/auth/(.*)",
      "destination": "https://pivotal-bedrock-c01dl.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/(.*)",
      "destination": "https://pivotal-bedrock-c01dl.firebaseapp.com/__/firebase/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/lectures/",
      "destination": "/index.html"
    },
    {
      "source": "/lectures/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
